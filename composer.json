{
    "name": "zerofront/module-zero-social-login",
    "description": "Zero for Magento Open Source: sign in and sign up with Google, Apple or Facebook, without third-party libraries.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "social-login",
        "oauth",
        "openid-connect"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-customer": "*",
        "magento/module-paypal": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-core": "^1.3",
        "zerofront/module-zero-checkout": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-social-login": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\SocialLogin\\": ""
        }
    }
}
